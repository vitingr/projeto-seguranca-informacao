# Copie para .env e preencha. O .env é ignorado pelo git: nunca versione segredos.
# Valores sem aspas e sem comentários na mesma linha.

# ---------------------------------------------------------------------------
# PostgreSQL (docker compose)
# ---------------------------------------------------------------------------
POSTGRES_USER=backend_si
# Obrigatória. Gere com: openssl rand -hex 24
# Use apenas caracteres seguros em URL (a senha é interpolada em DATABASE_URL).
POSTGRES_PASSWORD=
POSTGRES_DB=backend_si
# Porta publicada em 127.0.0.1 para migrations/seed executados no host.
POSTGRES_HOST_PORT=5432

# ---------------------------------------------------------------------------
# Aplicação
# ---------------------------------------------------------------------------
# Opcional no host: se vazia, o Magefile monta a URL a partir de POSTGRES_*
# apontando para 127.0.0.1. No contêiner, o compose define a URL com host "db".
# DATABASE_URL=postgres://backend_si:SENHA@127.0.0.1:5432/backend_si?sslmode=disable

APP_ADDR=:8443
APP_TLS_CERT_FILE=certs/server.crt
APP_TLS_KEY_FILE=certs/server.key
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
SESSION_IDLE_TIMEOUT=15m
SHUTDOWN_TIMEOUT=15s
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Seed do primeiro administrador ("mage seed")
# ---------------------------------------------------------------------------
SEED_ADMIN_LOGIN=admin
# Obrigatória para o seed. Não reutilize senhas.
SEED_ADMIN_PASSWORD=
