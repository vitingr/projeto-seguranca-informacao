# Copy to .env. No quotes and no inline comments.

# PostgreSQL
POSTGRES_USER=backend_si
# Generate with: openssl rand -hex 24 (URL-safe characters only)
POSTGRES_PASSWORD=
POSTGRES_DB=backend_si
POSTGRES_HOST_PORT=5432

# Application
# Optional: built from POSTGRES_* when empty
# DATABASE_URL=postgres://backend_si:SENHA@127.0.0.1:5432/backend_si?sslmode=disable

APP_ADDR=:8443
APP_TLS_CERT_FILE=certs/server.crt
APP_TLS_KEY_FILE=certs/server.key
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
SESSION_IDLE_TIMEOUT=15m
# 1m to 168h, at least SESSION_IDLE_TIMEOUT
SESSION_ABSOLUTE_TIMEOUT=8h
SHUTDOWN_TIMEOUT=15s
LOG_LEVEL=info

# Seed ("mage seed")
SEED_ADMIN_LOGIN=admin
# 15 to 128 characters
SEED_ADMIN_PASSWORD=
