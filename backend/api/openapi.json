{
  "openapi": "3.1.0",
  "info": {
    "title": "backend_si API",
    "version": "0.1.0",
    "description": "JSON API consumed by the frontend.\n\nThis contract describes the behavior of every route (successes and errors).\n\n**Session.** The session lives on the server and is identified by the `__Host-session` cookie (`HttpOnly`, `Secure`, `SameSite=Lax`, `Path=/`, no `Max-Age`). Only `GET /api/csrf` creates a session: it starts an anonymous one when there is none. A successful login replaces it with a new session (new cookie and new CSRF token), and logout deletes it. A session ends after `SESSION_IDLE_TIMEOUT` without requests (default 15 minutes) or `SESSION_ABSOLUTE_TIMEOUT` after login (default 8 hours), whichever comes first; the next request is then anonymous.\n\n**CSRF.** Every state-changing request (any method other than GET, HEAD and OPTIONS) must send the session cookie and the token returned by `GET /api/csrf` in the `X-CSRF-Token` header. The token changes at login: call `GET /api/csrf` again after logging in. Browser requests are also checked with Fetch Metadata: `Sec-Fetch-Site` must be `same-origin` or `none`, and without it an `Origin` that does not match the host is rejected. Clients that send neither header (curl, Bruno) only need the token.\n\n**Access policy.** Each operation declares the `x-policy` extension: `\"public\"`, or the list of roles allowed to call it (`admin`, `comum`). Anonymous callers of a restricted operation get 401; authenticated callers without an allowed role get 403. The role is read from the database on every request, so a role change applies to the caller's next request, with no new login.\n\n**Errors.** Every error response has the `ErrorResponse` body. `request_id` matches the `X-Request-Id` response header."
  },
  "servers": [
    {
      "url": "https://localhost",
      "description": "local"
    }
  ],
  "tags": [
    {
      "name": "health",
      "description": "Liveness check."
    },
    {
      "name": "auth",
      "description": "CSRF token, login, logout and the current user."
    },
    {
      "name": "users",
      "description": "User registration."
    },
    {
      "name": "areas",
      "description": "Role-restricted areas."
    },
    {
      "name": "posts",
      "description": "The post wall: posts of every user, edited and deleted by their authors, and removed by administrators."
    },
    {
      "name": "audit",
      "description": "The append-only audit log of security events, read by administrators."
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz",
        "tags": ["health"],
        "summary": "Health check",
        "description": "Reports that the process is serving HTTPS. It does not query the database.",
        "x-policy": "public",
        "responses": {
          "200": {
            "description": "The process is up.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StatusResponse" },
                "example": { "status": "ok" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/csrf": {
      "get": {
        "operationId": "getCsrfToken",
        "tags": ["auth"],
        "summary": "Get CSRF token",
        "description": "Returns the CSRF token of the current session (anonymous or authenticated) and the header that must carry it. Starts an anonymous session when there is none; this is the only route that creates sessions. Call it again after login, because the token changes.",
        "x-policy": "public",
        "responses": {
          "200": {
            "description": "The session's CSRF token.",
            "headers": {
              "Set-Cookie": {
                "description": "Only when the request had no valid session: the cookie of the new anonymous session (`__Host-session=<token>; Path=/; HttpOnly; Secure; SameSite=Lax`).",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CsrfResponse" },
                "example": {
                  "csrf_token": "MZXW6YTBOI4DCMRTGQ2TMNZYHE",
                  "header": "X-CSRF-Token"
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/login": {
      "post": {
        "operationId": "login",
        "tags": ["auth"],
        "summary": "Log in",
        "description": "Checks the credentials and starts a new authenticated session. Unknown users and wrong passwords get the same 401 response.",
        "x-policy": "public",
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" },
              "example": {
                "login": "admin",
                "senha": "correct-horse-battery-staple"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged in. A new session cookie is set.",
            "headers": {
              "Set-Cookie": {
                "description": "The cookie of the new authenticated session, which replaces the anonymous one. The CSRF token changes too: call `GET /api/csrf` again.",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" },
                "example": { "user_id": 1, "login": "admin", "role": "admin" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/logout": {
      "post": {
        "operationId": "logout",
        "tags": ["auth"],
        "summary": "Log out",
        "description": "Deletes the current session. The request has no body.",
        "x-policy": ["admin", "comum"],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "responses": {
          "204": {
            "description": "Logged out. The session no longer exists.",
            "headers": {
              "Set-Cookie": {
                "description": "Expires the session cookie (`__Host-session=; Path=/; Max-Age=0; HttpOnly; Secure; SameSite=Lax`).",
                "schema": { "type": "string" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/me": {
      "get": {
        "operationId": "getCurrentUser",
        "tags": ["auth"],
        "summary": "Get current user",
        "description": "Returns who is authenticated and with which role.",
        "x-policy": ["admin", "comum"],
        "responses": {
          "200": {
            "description": "The authenticated user. `login` is omitted.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" },
                "example": { "user_id": 1, "role": "admin" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/cadastro": {
      "post": {
        "operationId": "registerUser",
        "tags": ["users"],
        "summary": "Register user",
        "description": "Creates a user with the given role. Only administrators can register users.\n\n**400** (`bad_request`): the body is not well-formed for this operation: malformed JSON, a `Content-Type` other than `application/json`, an unknown field, or a field of the wrong JSON type (such as `\"papel\": 1`).\n\n**422** (`unprocessable_entity`): the body is well-formed but a value is invalid: `login` does not match the login pattern (after lowercasing), `senha` has fewer than 15 or more than 128 characters, `papel` is not exactly `admin` or `comum`, or a field is missing.\n\n**409** (`conflict`): the login is already taken, including by a login that differs only in case.\n\nThe response carries the normalized (lowercase) login.",
        "x-policy": ["admin"],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CadastroRequest" },
              "example": {
                "login": "maria.silva",
                "senha": "another-long-passphrase",
                "papel": "comum"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" },
                "example": { "user_id": 2, "login": "maria.silva", "role": "comum" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/administradores": {
      "get": {
        "operationId": "getAdminArea",
        "tags": ["areas"],
        "summary": "Admin area",
        "description": "Area restricted to administrators.",
        "x-policy": ["admin"],
        "responses": {
          "200": {
            "description": "Access granted.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AreaResponse" },
                "example": { "area": "administradores" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/usuarios": {
      "get": {
        "operationId": "getUserArea",
        "tags": ["areas"],
        "summary": "User area",
        "description": "Area restricted to the `comum` role. Administrators do not have access.",
        "x-policy": ["comum"],
        "responses": {
          "200": {
            "description": "Access granted.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AreaResponse" },
                "example": { "area": "usuarios" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/posts": {
      "get": {
        "operationId": "listPosts",
        "tags": ["posts"],
        "summary": "List posts",
        "description": "One page of the wall with the posts of every user, newest first (`created_at`, then `id`, descending), 20 posts per page. `has_next` tells whether a next page exists, and `mine` is true on the caller's own posts.\n\n**Removed posts.** A post removed by an administrator has `removal` set (otherwise it is `null`). A comum caller sees the posts that are not removed plus their own removed ones; an administrator sees every post, removed ones included, and `mine` is always `false` for an administrator. Administrators only read the wall and remove posts: creating, editing and deleting stay comum only.\n\n**400** (`bad_request`): `page` is not an integer from 1 to 10000.",
        "x-policy": ["admin", "comum"],
        "parameters": [{ "$ref": "#/components/parameters/Page" }],
        "responses": {
          "200": {
            "description": "One page of posts, possibly empty.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PostPage" },
                "example": {
                  "items": [
                    {
                      "id": 1,
                      "title": "Bem-vindos ao mural",
                      "body": "Primeiro post.\nSegunda linha.",
                      "author": { "user_id": 2, "login": "maria.silva" },
                      "created_at": "2026-11-22T12:00:00Z",
                      "updated_at": "2026-11-22T12:00:00Z",
                      "mine": true,
                      "removal": null
                    },
                    {
                      "id": 2,
                      "title": "Post removido",
                      "body": "Texto removido pela moderação.",
                      "author": { "user_id": 2, "login": "maria.silva" },
                      "created_at": "2026-11-22T11:00:00Z",
                      "updated_at": "2026-11-22T11:00:00Z",
                      "mine": true,
                      "removal": { "reason": "Conteúdo ofensivo.", "removed_at": "2026-11-22T11:30:00Z" }
                    }
                  ],
                  "page": 1,
                  "page_size": 20,
                  "has_next": false
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      },
      "post": {
        "operationId": "createPost",
        "tags": ["posts"],
        "summary": "Create post",
        "description": "Publishes a post as the caller. The title and body are trimmed and stored as plain text: clients must render them as text, never as HTML or markdown.\n\n**400** (`bad_request`): the body is not well-formed for this operation: malformed JSON, a `Content-Type` other than `application/json`, an unknown field, or a field of the wrong JSON type.\n\n**422** (`unprocessable_entity`): the body is well-formed but a value is invalid: `title` or `body` is missing, empty after trimming, too long, or has a control character that is not allowed (see `PostRequest`).",
        "x-policy": ["comum"],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PostRequest" },
              "example": {
                "title": "Bem-vindos ao mural",
                "body": "Primeiro post.\nSegunda linha."
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Post created.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Post" },
                "example": {
                  "id": 1,
                  "title": "Bem-vindos ao mural",
                  "body": "Primeiro post.\nSegunda linha.",
                  "author": { "user_id": 2, "login": "maria.silva" },
                  "created_at": "2026-11-22T12:00:00Z",
                  "updated_at": "2026-11-22T12:00:00Z",
                  "mine": true,
                  "removal": null
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/posts/{id}": {
      "put": {
        "operationId": "updatePost",
        "tags": ["posts"],
        "summary": "Update post",
        "description": "Replaces the title and body of one of the caller's posts, with the rules of `POST /api/posts`.\n\n**400** (`bad_request`): the body is not well-formed for this operation: malformed JSON, a `Content-Type` other than `application/json`, an unknown field, or a field of the wrong JSON type.\n\n**422** (`unprocessable_entity`): the body is well-formed but a value is invalid: `title` or `body` is missing, empty after trimming, too long, or has a control character that is not allowed (see `PostRequest`).\n\n**404** (`not_found`): no post with this `id` was written by the caller and is still on the wall: it does not exist, it belongs to another user, it was removed by an administrator (a removed post is frozen), or `id` is not a positive integer. The answer is the same in every case, so the caller cannot tell another user's post from a missing one.",
        "x-policy": ["comum"],
        "parameters": [
          { "$ref": "#/components/parameters/PostId" },
          { "$ref": "#/components/parameters/CsrfToken" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PostRequest" },
              "example": {
                "title": "Bem-vindos ao mural",
                "body": "Primeiro post.\nSegunda linha."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Post updated.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Post" },
                "example": {
                  "id": 1,
                  "title": "Bem-vindos ao mural",
                  "body": "Primeiro post.\nSegunda linha.",
                  "author": { "user_id": 2, "login": "maria.silva" },
                  "created_at": "2026-11-22T12:00:00Z",
                  "updated_at": "2026-11-22T12:00:00Z",
                  "mine": true,
                  "removal": null
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/PostNotFound" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      },
      "delete": {
        "operationId": "deletePost",
        "tags": ["posts"],
        "summary": "Delete post",
        "description": "Deletes one of the caller's posts. The request has no body.\n\n**404** (`not_found`): no post with this `id` was written by the caller and is still on the wall: it does not exist, it belongs to another user, it was removed by an administrator (a removed post is frozen), or `id` is not a positive integer. The answer is the same in every case, so the caller cannot tell another user's post from a missing one.",
        "x-policy": ["comum"],
        "parameters": [
          { "$ref": "#/components/parameters/PostId" },
          { "$ref": "#/components/parameters/CsrfToken" }
        ],
        "responses": {
          "204": { "description": "Post deleted." },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/PostNotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/posts/{id}/removal": {
      "post": {
        "operationId": "removePost",
        "tags": ["posts"],
        "summary": "Remove post",
        "description": "Removes any post from the wall, with a reason. The post is kept (soft delete) and frozen: its author can no longer edit or delete it, and it cannot be removed again. Other comum users no longer see it; its author and the administrators see it with `removal`. The removal and its `post_removed` audit event are written in one transaction.\n\n**400** (`bad_request`): the body is not well-formed for this operation: malformed JSON, a `Content-Type` other than `application/json`, an unknown field, or a field of the wrong JSON type.\n\n**422** (`unprocessable_entity`): the body is well-formed but `reason` is missing, empty after trimming, too long, or has a control character that is not allowed (see `RemovalRequest`).\n\n**404** (`not_found`): no post with this `id` is on the wall: it does not exist, it was already removed, or `id` is not a positive integer.",
        "x-policy": ["admin"],
        "parameters": [
          { "$ref": "#/components/parameters/PostId" },
          { "$ref": "#/components/parameters/CsrfToken" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RemovalRequest" },
              "example": { "reason": "Conteúdo ofensivo." }
            }
          }
        },
        "responses": {
          "204": { "description": "Post removed." },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/RemovalNotFound" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/audit-events": {
      "get": {
        "operationId": "listAuditEvents",
        "tags": ["audit"],
        "summary": "List audit events",
        "description": "One page of the audit log, newest first (`created_at`, then `id`, descending), 20 events per page, optionally only the events of one `type`. The log is append-only: there is no operation to change or delete an event.\n\nAn event never holds free text: no login typed in a failed login, no password, token or cookie. `actor` is the user who acted (`null` for a failed login); `target` is what the event is about (`null` for a login, a logout, or a failed login with an unknown login). The logins are read from the users when the log is listed and are left out when the user no longer exists.\n\n`ip` is the address of the direct TCP peer of the request (`null` if it did not parse). Forwarding headers such as `X-Forwarded-For` are ignored, so events sent through the frontend server record that server's address.\n\n**400** (`bad_request`): `type` is not one of the events, or `page` is not an integer from 1 to 10000.",
        "x-policy": ["admin"],
        "parameters": [
          { "$ref": "#/components/parameters/AuditType" },
          { "$ref": "#/components/parameters/Page" }
        ],
        "responses": {
          "200": {
            "description": "One page of events, possibly empty.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuditPage" },
                "example": {
                  "items": [
                    {
                      "id": 3,
                      "event": "post_removed",
                      "actor": { "user_id": 1, "login": "admin" },
                      "target": { "type": "post", "id": 2 },
                      "ip": "172.18.0.1",
                      "created_at": "2026-11-22T11:30:00Z"
                    },
                    {
                      "id": 2,
                      "event": "login_failed",
                      "actor": null,
                      "target": { "type": "user", "id": 2, "login": "maria.silva" },
                      "ip": "203.0.113.7",
                      "created_at": "2026-11-22T11:00:00Z"
                    },
                    {
                      "id": 1,
                      "event": "login_succeeded",
                      "actor": { "user_id": 1, "login": "admin" },
                      "target": null,
                      "ip": "::1",
                      "created_at": "2026-11-22T10:00:00Z"
                    }
                  ],
                  "page": 1,
                  "page_size": 20,
                  "has_next": false
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "CsrfToken": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "description": "CSRF token returned by `GET /api/csrf`.",
        "schema": { "type": "string" },
        "example": "{{csrfToken}}"
      },
      "PostId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "ID of the post.",
        "schema": { "type": "integer", "format": "int64", "minimum": 1 },
        "example": 1
      },
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "description": "Page of the list, starting at 1.",
        "schema": { "type": "integer", "minimum": 1, "maximum": 10000, "default": 1 },
        "example": 1
      },
      "AuditType": {
        "name": "type",
        "in": "query",
        "required": false,
        "description": "Only the events of this type. Empty or absent lists every event.",
        "schema": { "$ref": "#/components/schemas/AuditEventType" },
        "example": "login_failed"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The body is not valid JSON, is empty, has unknown fields or data after the first JSON value, is larger than 64 KiB, or the `Content-Type` is not `application/json` (with no charset or `charset=utf-8`).",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "error": "bad_request",
              "message": "A requisição não pôde ser processada.",
              "request_id": "0f8e2c4b9a7d4e1f"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Not authenticated (no session, or the session expired), or invalid credentials on login.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "error": "unauthorized",
              "message": "Autenticação necessária.",
              "request_id": "0f8e2c4b9a7d4e1f"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Missing or invalid CSRF token, a cross-origin browser request (Fetch Metadata), or a role that the operation does not allow.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "error": "forbidden",
              "message": "Você não tem permissão para acessar este recurso.",
              "request_id": "0f8e2c4b9a7d4e1f"
            }
          }
        }
      },
      "Conflict": {
        "description": "The login is already in use.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "error": "conflict",
              "message": "Este login já está em uso.",
              "request_id": "0f8e2c4b9a7d4e1f"
            }
          }
        }
      },
      "UnprocessableEntity": {
        "description": "The body is well-formed but a value is invalid (see the description of the operation).",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "error": "unprocessable_entity",
              "message": "Dados inválidos. Revise os campos e tente novamente.",
              "request_id": "0f8e2c4b9a7d4e1f"
            }
          }
        }
      },
      "InternalError": {
        "description": "Unexpected error. Details go to the log, never to the client.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "error": "internal",
              "message": "Ocorreu um erro inesperado. Tente novamente mais tarde.",
              "request_id": "0f8e2c4b9a7d4e1f"
            }
          }
        }
      },
      "PostNotFound": {
        "description": "No post with this ID was written by the caller.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "error": "not_found",
              "message": "Post não encontrado.",
              "request_id": "0f8e2c4b9a7d4e1f"
            }
          }
        }
      },
      "RemovalNotFound": {
        "description": "No post with this ID is on the wall: it does not exist or was already removed.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "error": "not_found",
              "message": "Post não encontrado.",
              "request_id": "0f8e2c4b9a7d4e1f"
            }
          }
        }
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["login", "senha"],
        "properties": {
          "login": { "type": "string", "description": "Login (case-insensitive)." },
          "senha": { "type": "string", "description": "Password.", "format": "password" }
        }
      },
      "CadastroRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["login", "senha", "papel"],
        "properties": {
          "login": { "type": "string", "description": "Login of the new user." },
          "senha": { "type": "string", "description": "Password of the new user.", "format": "password" },
          "papel": { "$ref": "#/components/schemas/Role" }
        }
      },
      "UserResponse": {
        "type": "object",
        "required": ["user_id", "role"],
        "properties": {
          "user_id": { "type": "integer", "format": "int64" },
          "login": { "type": "string", "description": "Omitted by `GET /api/me`." },
          "role": { "$ref": "#/components/schemas/Role" }
        }
      },
      "CsrfResponse": {
        "type": "object",
        "required": ["csrf_token", "header"],
        "properties": {
          "csrf_token": { "type": "string" },
          "header": { "type": "string", "description": "Header that must carry the token.", "const": "X-CSRF-Token" }
        }
      },
      "AreaResponse": {
        "type": "object",
        "required": ["area"],
        "properties": {
          "area": { "type": "string" }
        }
      },
      "StatusResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error", "message"],
        "properties": {
          "error": {
            "type": "string",
            "description": "Stable error code, such as `bad_request`, `unauthorized`, `forbidden`, `not_found`, `conflict`, `unprocessable_entity` or `internal`."
          },
          "message": { "type": "string", "description": "Generic message that is safe to show to the user." },
          "request_id": { "type": "string", "description": "Same value as the `X-Request-Id` header. Omitted in rare cases." }
        }
      },
      "Role": {
        "type": "string",
        "enum": ["admin", "comum"]
      },
      "PostRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "body"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "Trimmed, then 1 to 120 characters (Unicode code points) with no control characters."
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "Plain text. Trimmed, then 1 to 2000 characters (Unicode code points); the only control characters allowed are line feed, carriage return and tab."
          }
        }
      },
      "PostAuthor": {
        "type": "object",
        "required": ["user_id", "login"],
        "properties": {
          "user_id": { "type": "integer", "format": "int64" },
          "login": { "type": "string" }
        }
      },
      "Post": {
        "type": "object",
        "required": ["id", "title", "body", "author", "created_at", "updated_at", "mine", "removal"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "title": {
            "type": "string",
            "description": "Plain text: render it as text, never as HTML."
          },
          "body": {
            "type": "string",
            "description": "Plain text with line breaks: render it as text, never as HTML or markdown."
          },
          "author": { "$ref": "#/components/schemas/PostAuthor" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "mine": { "type": "boolean", "description": "True when the caller wrote the post." },
          "removal": {
            "description": "Set when an administrator removed the post, otherwise null. Only the author and the administrators see removed posts.",
            "oneOf": [{ "$ref": "#/components/schemas/PostRemoval" }, { "type": "null" }]
          }
        }
      },
      "PostRemoval": {
        "type": "object",
        "required": ["reason", "removed_at"],
        "properties": {
          "reason": {
            "type": "string",
            "description": "Plain text with line breaks: render it as text, never as HTML or markdown."
          },
          "removed_at": { "type": "string", "format": "date-time" }
        }
      },
      "RemovalRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason"],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "Plain text. Trimmed, then 1 to 500 characters (Unicode code points); the only control characters allowed are line feed, carriage return and tab."
          }
        }
      },
      "PostPage": {
        "type": "object",
        "required": ["items", "page", "page_size", "has_next"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Post" } },
          "page": { "type": "integer" },
          "page_size": { "type": "integer" },
          "has_next": { "type": "boolean" }
        }
      },
      "AuditEventType": {
        "type": "string",
        "enum": ["login_succeeded", "login_failed", "logout", "user_created", "post_removed"]
      },
      "AuditActor": {
        "type": "object",
        "required": ["user_id"],
        "properties": {
          "user_id": { "type": "integer", "format": "int64" },
          "login": { "type": "string", "description": "Left out when the user no longer exists." }
        }
      },
      "AuditTarget": {
        "type": "object",
        "required": ["type", "id"],
        "properties": {
          "type": { "type": "string", "enum": ["user", "post"] },
          "id": { "type": "integer", "format": "int64" },
          "login": {
            "type": "string",
            "description": "Only for a user target that still exists."
          }
        }
      },
      "AuditEvent": {
        "type": "object",
        "required": ["id", "event", "actor", "target", "ip", "created_at"],
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "event": { "$ref": "#/components/schemas/AuditEventType" },
          "actor": { "oneOf": [{ "$ref": "#/components/schemas/AuditActor" }, { "type": "null" }] },
          "target": { "oneOf": [{ "$ref": "#/components/schemas/AuditTarget" }, { "type": "null" }] },
          "ip": {
            "type": ["string", "null"],
            "description": "Address of the direct TCP peer, without the port. Forwarding headers are ignored."
          },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "AuditPage": {
        "type": "object",
        "required": ["items", "page", "page_size", "has_next"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/AuditEvent" } },
          "page": { "type": "integer" },
          "page_size": { "type": "integer" },
          "has_next": { "type": "boolean" }
        }
      }
    }
  }
}
