{
  "openapi": "3.1.0",
  "info": {
    "title": "backend_si API",
    "version": "0.1.0",
    "description": "JSON API consumed by the frontend.\n\nThis contract describes the behavior of every route (successes and errors).\n\n**Session.** The session lives on the server and is identified by the `__Host-session` cookie (`HttpOnly`, `Secure`, `SameSite=Lax`, `Path=/`, no `Max-Age`). Only `GET /api/csrf` creates a session: it starts an anonymous one when there is none. A successful login replaces it with a new session (new cookie and new CSRF token), and logout deletes it. A session ends after `SESSION_IDLE_TIMEOUT` without requests (default 15 minutes) or `SESSION_ABSOLUTE_TIMEOUT` after login (default 8 hours), whichever comes first; the next request is then anonymous.\n\n**CSRF.** Every state-changing request (any method other than GET, HEAD and OPTIONS) must send the session cookie and the token returned by `GET /api/csrf` in the `X-CSRF-Token` header. The token changes at login: call `GET /api/csrf` again after logging in. Browser requests are also checked with Fetch Metadata: `Sec-Fetch-Site` must be `same-origin` or `none`, and without it an `Origin` that does not match the host is rejected. Clients that send neither header (curl, Bruno) only need the token.\n\n**Access policy.** Each operation declares the `x-policy` extension: `\"public\"`, or the list of roles allowed to call it (`admin`, `comum`). Anonymous callers of a restricted operation get 401; authenticated callers without an allowed role get 403. The role is read from the database on every request, so a role change applies to the caller's next request, with no new login.\n\n**Errors.** Every error response has the `ErrorResponse` body. `request_id` matches the `X-Request-Id` response header."
  },
  "servers": [
    {
      "url": "https://localhost",
      "description": "local"
    }
  ],
  "tags": [
    {
      "name": "health",
      "description": "Liveness check."
    },
    {
      "name": "auth",
      "description": "CSRF token, login, logout and the current user."
    },
    {
      "name": "users",
      "description": "User registration."
    },
    {
      "name": "areas",
      "description": "Role-restricted areas."
    },
    {
      "name": "tickets",
      "description": "Support tickets."
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "healthz",
        "tags": ["health"],
        "summary": "Health check",
        "description": "Reports that the process is serving HTTPS. It does not query the database.",
        "x-policy": "public",
        "responses": {
          "200": {
            "description": "The process is up.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StatusResponse" },
                "example": { "status": "ok" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/csrf": {
      "get": {
        "operationId": "getCsrfToken",
        "tags": ["auth"],
        "summary": "Get CSRF token",
        "description": "Returns the CSRF token of the current session (anonymous or authenticated) and the header that must carry it. Starts an anonymous session when there is none; this is the only route that creates sessions. Call it again after login, because the token changes.",
        "x-policy": "public",
        "responses": {
          "200": {
            "description": "The session's CSRF token.",
            "headers": {
              "Set-Cookie": {
                "description": "Only when the request had no valid session: the cookie of the new anonymous session (`__Host-session=<token>; Path=/; HttpOnly; Secure; SameSite=Lax`).",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CsrfResponse" },
                "example": {
                  "csrf_token": "MZXW6YTBOI4DCMRTGQ2TMNZYHE",
                  "header": "X-CSRF-Token"
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/login": {
      "post": {
        "operationId": "login",
        "tags": ["auth"],
        "summary": "Log in",
        "description": "Checks the credentials and starts a new authenticated session. Unknown users and wrong passwords get the same 401 response.",
        "x-policy": "public",
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" },
              "example": {
                "login": "admin",
                "senha": "correct-horse-battery-staple"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logged in. A new session cookie is set.",
            "headers": {
              "Set-Cookie": {
                "description": "The cookie of the new authenticated session, which replaces the anonymous one. The CSRF token changes too: call `GET /api/csrf` again.",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" },
                "example": { "user_id": 1, "login": "admin", "role": "admin" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/logout": {
      "post": {
        "operationId": "logout",
        "tags": ["auth"],
        "summary": "Log out",
        "description": "Deletes the current session. The request has no body.",
        "x-policy": ["admin", "comum"],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "responses": {
          "204": {
            "description": "Logged out. The session no longer exists.",
            "headers": {
              "Set-Cookie": {
                "description": "Expires the session cookie (`__Host-session=; Path=/; Max-Age=0; HttpOnly; Secure; SameSite=Lax`).",
                "schema": { "type": "string" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/me": {
      "get": {
        "operationId": "getCurrentUser",
        "tags": ["auth"],
        "summary": "Get current user",
        "description": "Returns who is authenticated and with which role.",
        "x-policy": ["admin", "comum"],
        "responses": {
          "200": {
            "description": "The authenticated user. `login` is omitted.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" },
                "example": { "user_id": 1, "role": "admin" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/cadastro": {
      "post": {
        "operationId": "registerUser",
        "tags": ["users"],
        "summary": "Register user",
        "description": "Creates a user with the given role. Only administrators can register users.\n\n**400** (`bad_request`): the body is not well-formed for this operation: malformed JSON, a `Content-Type` other than `application/json`, an unknown field, or a field of the wrong JSON type (such as `\"papel\": 1`).\n\n**422** (`unprocessable_entity`): the body is well-formed but a value is invalid: `login` does not match the login pattern (after lowercasing), `senha` has fewer than 15 or more than 128 characters, `papel` is not exactly `admin` or `comum`, or a field is missing.\n\n**409** (`conflict`): the login is already taken, including by a login that differs only in case.\n\nThe response carries the normalized (lowercase) login.",
        "x-policy": ["admin"],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CadastroRequest" },
              "example": {
                "login": "maria.silva",
                "senha": "another-long-passphrase",
                "papel": "comum"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UserResponse" },
                "example": { "user_id": 2, "login": "maria.silva", "role": "comum" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/UnprocessableEntity" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/administradores": {
      "get": {
        "operationId": "getAdminArea",
        "tags": ["areas"],
        "summary": "Admin area",
        "description": "Area restricted to administrators.",
        "x-policy": ["admin"],
        "responses": {
          "200": {
            "description": "Access granted.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AreaResponse" },
                "example": { "area": "administradores" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/usuarios": {
      "get": {
        "operationId": "getUserArea",
        "tags": ["areas"],
        "summary": "User area",
        "description": "Area restricted to the `comum` role. Administrators do not have access.",
        "x-policy": ["comum"],
        "responses": {
          "200": {
            "description": "Access granted.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AreaResponse" },
                "example": { "area": "usuarios" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/tickets": {
      "post": {
        "operationId": "createTicket",
        "tags": ["tickets"],
        "summary": "Create ticket",
        "description": "Creates a support ticket for the `comum` user of the session. Administrators get 403.\n\n`tipo` picks the type and `dados` carries only the fields of that type (see `CreateTicketRequest`). Text fields are trimmed and their lengths are counted in Unicode characters (code points). Single-line fields accept no control character, line break or tab; multi-line fields accept line feed, carriage return and tab only. `repositorio` must be an absolute `https://` URL with a host and no user name or password.\n\nThe author is the user of the session, the status is always `aberto`, and the id and the dates are set by the server: the body cannot carry them. Titles of `acesso`, `bug` and `deploy` tickets are built by the server: `Acesso a <sistema>`, `Bug em <sistema>`, `Deploy de <projeto> em <ambiente>` (with the environment label), cut to 120 characters; `outro` keeps `titulo`.\n\n**400** (`bad_request`): the body is not well-formed for this operation: malformed JSON, a body that is not valid UTF-8, a `Content-Type` other than `application/json`, a key that is not one of the documented names spelled exactly (case-sensitive), a key of another type, a duplicate key (also when only the case differs), a field of the wrong JSON type, or `dados` missing or `null`. Keys the server owns (`author`, `user_id`, `status`, `id`, `created_at`, ...) are unknown keys.\n\n**422** (`unprocessable_entity`): the body is well-formed but a value is invalid: an unknown `tipo`, a missing or empty required field, a length out of its limits, a forbidden character, a code outside its list, or a repository that is not an https URL. The answer never names the field.\n\nNothing is stored when the answer is not 201. The response does not echo the field contents.",
        "x-policy": ["comum"],
        "parameters": [{ "$ref": "#/components/parameters/CsrfToken" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTicketRequest" },
              "example": {
                "tipo": "acesso",
                "dados": {
                  "sistema": "Grafana",
                  "nivel_acesso": "leitura",
                  "justificativa": "Preciso ver os painéis de monitoramento da equipe."
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ticket created with status `aberto`.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TicketResponse" },
                "example": {
                  "id": 1,
                  "type": "acesso",
                  "title": "Acesso a Grafana",
                  "status": "aberto",
                  "created_at": "2026-11-25T14:30:00.123456Z",
                  "updated_at": "2026-11-25T14:30:00.123456Z"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "422": { "$ref": "#/components/responses/InvalidTicketData" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "CsrfToken": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "description": "CSRF token returned by `GET /api/csrf`.",
        "schema": { "type": "string" },
        "example": "{{csrfToken}}"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The body is not valid JSON, is empty, has unknown fields or data after the first JSON value, is larger than 64 KiB, or the `Content-Type` is not `application/json` (with no charset or `charset=utf-8`).",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "error": "bad_request",
              "message": "A requisição não pôde ser processada.",
              "request_id": "0f8e2c4b9a7d4e1f"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Not authenticated (no session, or the session expired), or invalid credentials on login.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "error": "unauthorized",
              "message": "Autenticação necessária.",
              "request_id": "0f8e2c4b9a7d4e1f"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Missing or invalid CSRF token, a cross-origin browser request (Fetch Metadata), or a role that the operation does not allow.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "error": "forbidden",
              "message": "Você não tem permissão para acessar este recurso.",
              "request_id": "0f8e2c4b9a7d4e1f"
            }
          }
        }
      },
      "Conflict": {
        "description": "The login is already in use.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "error": "conflict",
              "message": "Este login já está em uso.",
              "request_id": "0f8e2c4b9a7d4e1f"
            }
          }
        }
      },
      "UnprocessableEntity": {
        "description": "Invalid login, password or role.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "error": "unprocessable_entity",
              "message": "Dados inválidos. Revise os campos e tente novamente.",
              "request_id": "0f8e2c4b9a7d4e1f"
            }
          }
        }
      },
      "InvalidTicketData": {
        "description": "A ticket value is invalid. The answer never says which field.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "error": "unprocessable_entity",
              "message": "Dados inválidos. Revise os campos e tente novamente.",
              "request_id": "0f8e2c4b9a7d4e1f"
            }
          }
        }
      },
      "InternalError": {
        "description": "Unexpected error. Details go to the log, never to the client.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" },
            "example": {
              "error": "internal",
              "message": "Ocorreu um erro inesperado. Tente novamente mais tarde.",
              "request_id": "0f8e2c4b9a7d4e1f"
            }
          }
        }
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["login", "senha"],
        "properties": {
          "login": { "type": "string", "description": "Login (case-insensitive)." },
          "senha": { "type": "string", "description": "Password.", "format": "password" }
        }
      },
      "CadastroRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["login", "senha", "papel"],
        "properties": {
          "login": { "type": "string", "description": "Login of the new user." },
          "senha": { "type": "string", "description": "Password of the new user.", "format": "password" },
          "papel": { "$ref": "#/components/schemas/Role" }
        }
      },
      "UserResponse": {
        "type": "object",
        "required": ["user_id", "role"],
        "properties": {
          "user_id": { "type": "integer", "format": "int64" },
          "login": { "type": "string", "description": "Omitted by `GET /api/me`." },
          "role": { "$ref": "#/components/schemas/Role" }
        }
      },
      "CsrfResponse": {
        "type": "object",
        "required": ["csrf_token", "header"],
        "properties": {
          "csrf_token": { "type": "string" },
          "header": { "type": "string", "description": "Header that must carry the token.", "const": "X-CSRF-Token" }
        }
      },
      "AreaResponse": {
        "type": "object",
        "required": ["area"],
        "properties": {
          "area": { "type": "string" }
        }
      },
      "StatusResponse": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error", "message"],
        "properties": {
          "error": {
            "type": "string",
            "description": "Stable error code, such as `bad_request`, `unauthorized`, `forbidden`, `not_found`, `conflict`, `unprocessable_entity` or `internal`."
          },
          "message": { "type": "string", "description": "Generic message that is safe to show to the user." },
          "request_id": { "type": "string", "description": "Same value as the `X-Request-Id` header. Omitted in rare cases." }
        }
      },
      "Role": {
        "type": "string",
        "enum": ["admin", "comum"]
      },
      "CreateTicketRequest": {
        "description": "A ticket request: `tipo` and the `dados` of that type, with no other key.",
        "oneOf": [
          { "$ref": "#/components/schemas/AccessTicketRequest" },
          { "$ref": "#/components/schemas/BugTicketRequest" },
          { "$ref": "#/components/schemas/DeployTicketRequest" },
          { "$ref": "#/components/schemas/OtherTicketRequest" }
        ],
        "discriminator": {
          "propertyName": "tipo",
          "mapping": {
            "acesso": "#/components/schemas/AccessTicketRequest",
            "bug": "#/components/schemas/BugTicketRequest",
            "deploy": "#/components/schemas/DeployTicketRequest",
            "outro": "#/components/schemas/OtherTicketRequest"
          }
        }
      },
      "AccessTicketRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tipo", "dados"],
        "properties": {
          "tipo": { "type": "string", "const": "acesso" },
          "dados": { "$ref": "#/components/schemas/AccessTicketData" }
        }
      },
      "BugTicketRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tipo", "dados"],
        "properties": {
          "tipo": { "type": "string", "const": "bug" },
          "dados": { "$ref": "#/components/schemas/BugTicketData" }
        }
      },
      "DeployTicketRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tipo", "dados"],
        "properties": {
          "tipo": { "type": "string", "const": "deploy" },
          "dados": { "$ref": "#/components/schemas/DeployTicketData" }
        }
      },
      "OtherTicketRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tipo", "dados"],
        "properties": {
          "tipo": { "type": "string", "const": "outro" },
          "dados": { "$ref": "#/components/schemas/OtherTicketData" }
        }
      },
      "AccessTicketData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sistema", "nivel_acesso", "justificativa"],
        "properties": {
          "sistema": { "type": "string", "minLength": 2, "maxLength": 120, "description": "System or resource. Single-line." },
          "nivel_acesso": { "$ref": "#/components/schemas/AccessLevel" },
          "justificativa": { "type": "string", "minLength": 10, "maxLength": 2000, "description": "Multi-line." }
        }
      },
      "BugTicketData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sistema", "descricao", "passos", "severidade"],
        "properties": {
          "sistema": { "type": "string", "minLength": 2, "maxLength": 120, "description": "Affected system. Single-line." },
          "descricao": { "type": "string", "minLength": 10, "maxLength": 2000, "description": "Multi-line." },
          "passos": { "type": "string", "minLength": 10, "maxLength": 2000, "description": "Steps to reproduce. Multi-line." },
          "severidade": { "$ref": "#/components/schemas/Severity" }
        }
      },
      "DeployTicketData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["projeto", "repositorio", "ambiente"],
        "properties": {
          "projeto": { "type": "string", "minLength": 2, "maxLength": 120, "description": "Project name. Single-line." },
          "repositorio": {
            "type": "string",
            "maxLength": 300,
            "format": "uri",
            "description": "Absolute `https://` URL with a host and no user name or password. SSH addresses are refused."
          },
          "ambiente": { "$ref": "#/components/schemas/Environment" },
          "observacoes": {
            "type": ["string", "null"],
            "maxLength": 2000,
            "description": "Optional. Multi-line. Absent, `null` and empty (after trimming) all mean no notes."
          }
        }
      },
      "OtherTicketData": {
        "type": "object",
        "additionalProperties": false,
        "required": ["titulo", "descricao"],
        "properties": {
          "titulo": { "type": "string", "minLength": 2, "maxLength": 120, "description": "Title of the ticket. Single-line." },
          "descricao": { "type": "string", "minLength": 10, "maxLength": 2000, "description": "Multi-line." }
        }
      },
      "TicketResponse": {
        "type": "object",
        "required": ["id", "type", "title", "status", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "integer", "format": "int64", "description": "Ticket number, shown as `#<id>`." },
          "type": { "$ref": "#/components/schemas/TicketType" },
          "title": { "type": "string", "maxLength": 120 },
          "status": { "$ref": "#/components/schemas/TicketStatus" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time", "description": "Equal to `created_at` for a new ticket." }
        }
      },
      "TicketType": {
        "type": "string",
        "enum": ["acesso", "bug", "deploy", "outro"]
      },
      "TicketStatus": {
        "type": "string",
        "description": "A new ticket is always `aberto`; the other statuses belong to later features.",
