# Copy to .env.local if you need other values. Never commit .env.local.

# Backend origin, used by the /api rewrite and by server-side calls. Must be
# https with no path. https://localhost is the docker compose stack
# ("go tool mage dockerUp"); use https://localhost:8443 for "go tool mage run".
API_URL=https://localhost

# Public URL of this app (metadata).
NEXT_PUBLIC_BASE_URL=https://localhost:3000

# BACKEND_CERT_DIR (folder with server.crt and server.key, default
# ../backend/certs) is read by "pnpm dev" before Next starts, so it must be
# set in the shell, not in this file.
